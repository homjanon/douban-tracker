# ===== 必填：豆瓣登录态 Cookie（私仓 Settings → Secrets 注入，勿提交）=====
DOUBAN_COOKIE=bid=xxx; ck=xxx; etc

# ===== 双模式抓取源 =====
# 模式切换：topic=用户主页广播(默认,开启) / group=小组话题(切回,开启)
SCRAPE_MODE=topic

# 新模式(默认)：用户主页广播页（楼主现改为在本人主页发广播/话题，URL 含 /statuses）
DOUBAN_USER_STATUSES_URL=https://www.douban.com/people/295613619/statuses

# 旧模式(可切回)：小组 URL，多组逗号分隔；当前新模式开启，此处可留空
DOUBAN_GROUP_URLS=

# 目标楼主昵称（两种模式共用，用于过滤发言）
DOUBAN_TARGET_USER=楼主昵称

# ===== 选填：LLM 后端（四级，按序降级；首个有 Key 且调用成功即生效）=====
# ① 一级：商汤 DeepSeek V4.1 Flash（新模型，全局限流紧，代码内带 429 退避重试）
# Model ID 为 deepseek-flash（官方「DeepSeek V4.1 Flash」）；旧版 V4 Flash 是 deepseek-v4-flash，两者并存
SENSENOVA_API_KEY=sk-xxx
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
DEEPSEEK_MODEL=deepseek-flash

# ② 二级：商汤 DeepSeek V4 Flash —— 同 Key 同端点，①被限流时回落到这里（实测稳定）
DEEPSEEK_LEGACY_MODEL=deepseek-v4-flash

# ③ 三级：Agnes AI 免费多模态
AGNES_API_KEY=sk-xxx
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# ④ 兜底：Google Gemini 3 Flash（免费，1500 RPD）
# ⚠️ 模型名必须带 -preview 后缀，无后缀会 404
GEMINI_API_KEY=xxx
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3-flash-preview

# ===== 抓取参数 =====
PAGES=3
RECENT_N=10
AGGREGATE_THRESHOLD=50
